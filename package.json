{
  "name": "mirrorz-excel",
  "version": "0.1.0",
  "private": true,
  "description": "MIRRORZ Sheets - an offline-first spreadsheet application that opens, edits and saves Excel-compatible files",
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --build --force && npm run typecheck --workspace @mirrorz/desktop",
    "fixtures": "node tools/make-fixtures.mjs",
    "build:web": "npm run build --workspace @mirrorz/desktop && node tools/bundle-single-file.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
